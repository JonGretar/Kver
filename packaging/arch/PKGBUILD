# Maintainer: troyhy
pkgname=kver
pkgver=0.8.0
pkgrel=1
pkgdesc='Fast PDF reader with Vim-style navigation (GPUI)'
arch=('x86_64')
url='https://github.com/JonGretar/Kver'
license=('MIT')
depends=('fontconfig' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'libx11' 'libxcb' 'xdg-desktop-portal')
makedepends=('cargo' 'clang' 'cmake' 'pkgconf')
# makepkg's default LTO adds -flto=auto to CFLAGS; ring's C objects then fail to link under ld.lld.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('2535dbd7066a6b47869f76525e45b01defe5ecd4ae8d493e9fdef8d3d5f0777d')

prepare() {
  cd "Kver-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "Kver-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin kver
}

check() {
  cd "Kver-$pkgver"
  target/release/kver --version
}

package() {
  cd "Kver-$pkgver"
  install -Dm755 target/release/kver "$pkgdir/usr/bin/kver"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/png/$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/kver.png"
  done
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/kver.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Kver
Comment=Read PDF documents
Exec=kver -- %f
Icon=kver
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;
StartupWMClass=kver
EOF
  install -Dm644 docs/cli.md "$pkgdir/usr/share/doc/$pkgname/cli.md"
  install -Dm644 docs/keybindings.md "$pkgdir/usr/share/doc/$pkgname/keybindings.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
