# Maintainer: troyhy
pkgname=kver
pkgver=0.8.2
pkgrel=1
pkgdesc='Fast PDF reader with Vim-style navigation (GPUI)'
arch=('x86_64')
url='https://github.com/JonGretar/Kver'
license=('MIT')
depends=('fontconfig' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader' 'libglvnd' 'libx11' 'libxcb' 'xdg-desktop-portal')
makedepends=('cargo' 'cargo-about' 'clang' 'cmake' 'pkgconf' 'python')
# makepkg's default LTO adds -flto=auto to CFLAGS; ring's C objects then fail to link under ld.lld.
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('65a002b4c632b938538517e81bf7f685be3425bea3a63f280bca87d1b79c042e')

prepare() {
  cd "Kver-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  # cargo-about resolves the locked graph before filtering it to Linux.
  cargo fetch --locked
}

build() {
  cd "Kver-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release --bin kver
  # Use the recipe checkout's approved policy, even for an older source tag.
  cargo about generate --frozen --fail -c "$startdir/../linux/about.toml" \
    -o target/THIRD-PARTY-LICENSES.html "$startdir/../common/licenses.hbs"
}

check() {
  cd "Kver-$pkgver"
  target/release/kver --version
}

package() {
  cd "Kver-$pkgver"
  install -Dm755 target/release/kver "$pkgdir/usr/bin/kver"
  for s in 16 24 32 48 64 128 256 512; do
    install -Dm644 "assets/icons/png/$s.png" "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/kver.png"
  done
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/kver.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Kver
Comment=Read PDF documents
Exec=kver -- %f
Icon=kver
Terminal=false
Categories=Office;Viewer;
MimeType=application/pdf;
StartupWMClass=kver
EOF
  install -Dm644 docs/cli.md "$pkgdir/usr/share/doc/$pkgname/cli.md"
  install -Dm644 docs/keybindings.md "$pkgdir/usr/share/doc/$pkgname/keybindings.md"
  local license_dir="$pkgdir/usr/share/licenses/$pkgname"
  install -Dm644 LICENSE "$license_dir/LICENSE"
  install -Dm644 target/THIRD-PARTY-LICENSES.html "$license_dir/THIRD-PARTY-LICENSES.html"
  python "$startdir/../common/collect-notices.py" "$PWD" x86_64-unknown-linux-gnu \
    "$license_dir" --offline
}
